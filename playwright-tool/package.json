{
  "name": "gemmicro-tech-auto",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright automation test project",
  "scripts": {
    "clean:results": "node ./scripts/clean-results.mjs",
    "test": "npm run clean:results && playwright test",
    "test:smoke": "npm run clean:results && playwright test -g \"@smoke\"",
    "test:p0": "npm run clean:results && playwright test -g \"@P0\"",
    "test:p1": "npm run clean:results && playwright test -g \"@P1\"",
    "test:p2": "npm run clean:results && playwright test -g \"@P2\"",
    "test:headed": "npm run clean:results && playwright test --headed",
    "test:ui": "npm run clean:results && playwright test --ui",
    "report": "playwright show-report",
    "allure:generate": "node ./scripts/allure-generate.cjs",
    "allure:open": "node ./scripts/allure-open-latest.cjs",
    "test:report": "npm run test && npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1"
  }
}
